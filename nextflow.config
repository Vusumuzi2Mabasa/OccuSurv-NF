params.outdir='results'
manifest {
 name='occusurv-nf'
 version='0.3.0'
 nextflowVersion='>=25.10.2'
}
process {
 executor='local'
 cpus=1
 memory='2 GB'
 time='20m'
 errorStrategy='terminate'
}
executor.queueSize=2
trace { enabled=true; file="${params.outdir}/execution/trace.tsv"; overwrite=true }
report { enabled=true; file="${params.outdir}/execution/nextflow-report.html"; overwrite=true }
timeline { enabled=true; file="${params.outdir}/execution/timeline.html"; overwrite=true }
profiles {
 smoke {
  params.n_workers=40
  params.outdir='results-smoke'
 }
 slurm { process.executor='slurm' }
}
